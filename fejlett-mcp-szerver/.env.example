# Classic PAT: repo + read:org. SSO-nál Authorize. Értékét ne commitold.
GITHUB_PERSONAL_ACCESS_TOKEN=

# QR PNG mappája. Üresen a Letöltések.
QR_OUTPUT_DIR=~/Downloads

# Külső MCP-k JSON-ja. off vagy none kikapcsolja őket.
MCP_EXTERNALS=externals.json

# stdio vagy streamable-http
MCP_TRANSPORT=stdio

# HTTP kötés, ha a transport streamable-http.
HOST=0.0.0.0
PORT=8080
